# Copy to .env, fill in, then run:
#   docker compose up --build --abort-on-container-exit --exit-code-from harness

# From the API key email. MODEL=mock/solver runs fully offline (also: mock/idle,
# mock/cheater, mock/garbage, mock/text, mock/spam).
MODEL=mock/solver
API_KEY=
BASE_URL=

# Task and seed used at reset (see README for the task list).
TASK_ID=slugify
SEED=0

# full      = baseline checks, then the model on TASK_ID (default)
# all       = baseline checks for every task, then the model on every task
# baselines = baseline checks for every task, no model call
MODE=full

# Optional instructions file inside inputs/, appended to the system prompt as-is.
# Empty = inputs/append.txt if it exists. A named file that is missing/empty stops the run.
APPEND_FILE=

# Optional cap on each model reply (empty = provider default).
MAX_TOKENS=
